{% extends 'base.html.twig' %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
{% endblock %}

{% block title %}Mot de passe oublié — CF2m Centre de Formation{% endblock %}

{% block body_class %}page-login{% endblock %}

{% block body %}

<section class="cf2m-login-section">

    <div class="cf2m-login-blob cf2m-login-blob--tl" aria-hidden="true"></div>
    <div class="cf2m-login-blob cf2m-login-blob--br" aria-hidden="true"></div>

    <div class="container d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 70px);">
        <div class="cf2m-login-card">

            <div class="cf2m-login-header">
                <img src="{{ asset('images/logo-cf2m.svg') }}"
                     alt="Logo CF2m"
                     width="108" height="108"
                     class="cf2m-login-logo cf2m-login-logo--dark">
                <img src="{{ asset('images/logo-cf2m-bleu.svg') }}"
                     alt="Logo CF2m"
                     width="108" height="108"
                     class="cf2m-login-logo cf2m-login-logo--light">
                <h1 class="cf2m-login-title">Mot de passe oublié</h1>
                <p class="cf2m-login-subtitle">Indiquez votre adresse e-mail pour recevoir un lien de réinitialisation</p>
            </div>

            {% if error %}
                <div class="cf2m-login-error" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    {{ error }}
                </div>
            {% endif %}

            <form method="post" novalidate data-turbo="false">

                <div class="cf2m-login-field">
                    <label for="inputEmail" class="cf2m-login-label">Adresse e-mail</label>
                    <div class="cf2m-login-input-wrap">
                        <svg class="cf2m-login-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                        <input type="email"
                               id="inputEmail"
                               name="email"
                               class="cf2m-login-input"
                               placeholder="votre@email.com"
                               autocomplete="email"
                               autofocus
                               required>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">

                <div class="cf-turnstile mb-3"
                     data-sitekey="{{ turnstile_site_key }}"
                     data-theme="auto"
                     data-language="fr"></div>

                <button type="submit" class="cf2m-login-btn">
                    Envoyer le lien de réinitialisation
                </button>

            </form>

            <p class="cf2m-login-back">
                <a href="{{ path('app_login') }}">← Retour à la connexion</a>
            </p>

        </div>
    </div>

</section>

{% endblock %}
